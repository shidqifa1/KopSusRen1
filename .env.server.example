# Gunakan :80 untuk akses IP/HTTP, atau domain untuk HTTPS otomatis.
APP_ADDRESS=:80
APP_ENV=development

# Database Supabase utama yang sama dengan deployment lama.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Login web. Buat nilainya dengan: npm run generate:secrets -- shidqifa PASSWORD_BARU
VALID_USERNAME=shidqifa
AUTH_SECRET=replace-with-random-auth-secret
VALID_PASSWORD_HASH=replace-with-scrypt-password-hash

# WhatsApp gateway. Secret ini dipakai bersama oleh web dan gateway.
WA_SHARED_SECRET=replace-with-random-wa-secret
WA_OWNER_NUMBERS=6285175403169
WA_PAIRING_NUMBER=6280000000000
LOG_LEVEL=info

# AI dan QRIS.
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=openai/gpt-oss-120b
CHATBOT_V2_ENABLED=true
CHATBOT_MODE=confirmation
QRIS_IMAGE_URL=https://baristack.my.id/assets/qris-baristack.jpeg
