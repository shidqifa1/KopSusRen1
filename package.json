{
  "name": "baristack-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup:server": "bash ./setup-server.sh",
    "generate:secrets": "node scripts/generate-secrets.mjs",
    "vercel:env": "node --env-file=.env.local scripts/sync-vercel-env.mjs",
    "smoke:deployment": "node --env-file=.env.local scripts/smoke-deployment.mjs",
    "gateway:wa": "node --env-file=.env.local services/gateway/whatsapp.js",
    "build:docker": "tsc -p tsconfig.docker.json",
    "start:server": "node server/http.mjs",
    "docker:config": "docker compose --env-file .env.server config",
    "eval:chatbot": "node evals/run-evals.mjs --provider=deterministic",
    "eval:chatbot:groq": "node --env-file=.env.local evals/run-evals.mjs --provider=groq",
    "eval:shadow-export": "node evals/export-shadow.mjs",
    "check": "node --check services/chatbot/orchestrator.js && node --check services/chatbot/conversation.js && node --check services/parser/groqOrderParser.js && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "drizzle-orm": "beta",
    "groq-sdk": "^1.6.0",
    "pino": "^9.9.5",
    "postgres": "^3.4.9",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@vercel/node": "^5.8.9",
    "drizzle-kit": "beta",
    "vercel": "^59.11.2"
  }
}
