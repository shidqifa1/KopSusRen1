# Web/bot Node yang terus hidup: gunakan Supabase Session pooler (5432).
# postgres.js + shared Transaction pooler dapat hang/menukar hasil query.
# https://supabase.com/docs/guides/database/postgres-js
DATABASE_URL=postgresql://postgres.basimttvdoonfezdxoyk:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://basimttvdoonfezdxoyk.supabase.co
APP_ENV=development
AUTH_SECRET=generate-a-random-secret-at-least-32-bytes
VALID_USERNAME=shidqifa
VALID_PASSWORD_HASH=salt:scrypt_hash_64_bytes_hex
# Generate nilai secara lokal dengan: npm run generate:secrets -- "password-kamu"

# WhatsApp gateway development. Ini dipakai gateway lokal scan QR -> API V2.
WA_BACKEND_URL=https://baristack.my.id/api/v2/commands
WA_SHARED_SECRET=generate-random-secret-for-wa-gateway
WA_SESSION_DIR=./baileys_auth
# Opsional: isi nomor device WA untuk pairing code, contoh 62812xxxx.
# WA_PAIRING_NUMBER=62812xxxx
# Nomor owner dipisah koma. Chat dari nomor ini jadi mode owner, bukan pembeli.
WA_OWNER_NUMBERS=62812xxxx,62813xxxx
# Opsional: URL gambar QRIS publik untuk dikirim ke customer QRIS.
QRIS_IMAGE_URL=https://baristack.my.id/assets/qris-baristack.jpeg

# Optional AI parser via Groq. Tetap backend-only, jangan taruh di frontend.
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
CHATBOT_V2_ENABLED=true
# confirmation = chatbot aktif; shadow = observasi parser tanpa aksi/reply customer.
CHATBOT_MODE=confirmation
