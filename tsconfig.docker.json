{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["api/**/*.ts", "db/**/*.ts", "services/**/*.js"]
}
